{
  "info": {
    "name": "Wandr API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://wandr-ri3h.onrender.com",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Secure123!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', res.access_token);",
                  "pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "console.log('Tokens saved to collection variables.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "testuser" },
                { "key": "password", "value": "Secure123!" }
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', res.access_token);",
                  "pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "console.log('Tokens rotated and saved.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// The response is SSE streaming — first line contains the conversation_id.",
                  "// Example: data: {\"conversation_id\": 1}",
                  "const lines = pm.response.text().split('\\n');",
                  "for (const line of lines) {",
                  "  if (line.startsWith('data: {')) {",
                  "    try {",
                  "      const obj = JSON.parse(line.replace('data: ', ''));",
                  "      if (obj.conversation_id) {",
                  "        pm.collectionVariables.set('conversationId', obj.conversation_id);",
                  "        console.log('conversationId saved:', obj.conversation_id);",
                  "      }",
                  "    } catch(e) {}",
                  "    break;",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/chat", "host": ["{{baseUrl}}"], "path": ["chat"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What should I do in Tokyo for 3 days?\"\n}"
            }
          }
        },
        {
          "name": "Send Message (continue conversation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/chat", "host": ["{{baseUrl}}"], "path": ["chat"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What about food recommendations?\",\n  \"conversation_id\": {{conversationId}}\n}"
            }
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/chat/history", "host": ["{{baseUrl}}"], "path": ["chat", "history"] }
          }
        },
        {
          "name": "Get Conversation Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/chat/{{conversationId}}", "host": ["{{baseUrl}}"], "path": ["chat", "{{conversationId}}"] }
          }
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/chat/{{conversationId}}", "host": ["{{baseUrl}}"], "path": ["chat", "{{conversationId}}"] }
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Create Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('tripId', res.id);",
                  "console.log('Trip ID saved:', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/trips", "host": ["{{baseUrl}}"], "path": ["trips"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Japan\",\n  \"city\": \"Tokyo\",\n  \"start_date\": \"2025-03-01\",\n  \"end_date\": \"2025-03-14\",\n  \"duration_days\": 14,\n  \"vibe\": \"loved_it\",\n  \"travel_style\": \"solo\",\n  \"budget_level\": \"mid\",\n  \"notes\": \"Cherry blossom season\",\n  \"highlight\": \"Shibuya crossing at night\",\n  \"lowlight\": \"Crowds in Harajuku\",\n  \"would_return\": true,\n  \"is_public\": false\n}"
            }
          }
        },
        {
          "name": "List Trips",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/trips?offset=0&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["trips"],
              "query": [
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Trip by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}"] }
          }
        },
        {
          "name": "Update Trip",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"highlight\": \"Updated highlight\",\n  \"vibe\": \"mixed\"\n}"
            }
          }
        },
        {
          "name": "Delete Trip",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}"] }
          }
        }
      ]
    }
  ]
}
